# Copy this file to .env and fill in real values. Never commit the real .env.
# Local-only connection to the Day 6 PostgreSQL + pgvector container.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# OpenRouter key (used for embeddings and the agent LLM).
OPENROUTER_API_KEY=

# Models
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AGENT_MODEL=openai/gpt-4o-mini